{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota",
  "mainBinaryName": "Quota",
  "version": "0.1.0",
  "identifier": "com.usagecheck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Quota",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Quota",
    "category": "Utility",
    "shortDescription": "See how much AI usage you have left",
    "longDescription": "Quota shows the remaining usage of your Claude, ChatGPT, Anthropic API, OpenAI API, OpenRouter and DeepSeek accounts in one place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDNUExQjFBNjY4MzIyQ0QKUldUTklvTm1HaHRhZkhQTm05ZlpySkVxVWJKOXRRNG52c2pEb0ljZWczK2VpWmRqYXpaT0xGU0EK",
      "endpoints": [
        "https://github.com/devbehkame/usagecheck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
