{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UsageCheck",
  "version": "0.1.0",
  "identifier": "com.usagecheck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "UsageCheck",
        "width": 1040,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "UsageCheck",
    "category": "Utility",
    "shortDescription": "See how much AI usage you have left",
    "longDescription": "UsageCheck shows the remaining usage of your Claude, ChatGPT, Anthropic API, OpenAI API, OpenRouter and DeepSeek accounts in one place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
