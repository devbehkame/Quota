{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget",
  "description": "The taskbar widget may only listen for updates and be dragged",
  "windows": ["widget"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ]
}
